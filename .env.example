# @BotFather dan olinadigan token — MAJBURIY
BOT_TOKEN=123456789:AAExample-Token-Here

# Mini App joylashgan HTTPS manzil. Bo'sh qoldirilsa, 🗺 tugma ko'rsatilmaydi.
# GitHub Pages manzili (GitHub Actions avtomatik joylaydi)
WEBAPP_URL=https://developerilhombek.github.io/bus225/

# Ixtiyoriy: boshqa yo'nalish faylini ishlatish
# ROUTE_FILE=data/route.json

# Har bir yo'nalish uchun nechta keyingi avtobus ko'rsatilsin
NEXT_LIMIT=3

# ---------------------------------------------------------------- haydovchi rejimi
# Haydovchi / pul teruvchilar: telegram_id:avtobus, vergul bilan.
# Avtobus raqamisiz (faqat ID) — istalgan avtobusni tanlay oladi (admin/sinov uchun).
# ID'ni bilish: botga /myid yozing.
DRIVERS=

# "📍 1-avtobus — Perez" xabarlari yuboriladigan guruh (bot guruhga admin qilib qo'shilgan bo'lishi kerak).
# ID'ni bilish: guruhga @RawDataBot ni qo'shing yoki botni guruhga qo'shib /myid yozing.
GROUP_CHAT_ID=

# Jonli joylashuv API'si (nginx shu yerga yo'naltiradi)
API_HOST=127.0.0.1
API_PORT=8080
CORS_ORIGINS=https://developerilhombek.github.io
